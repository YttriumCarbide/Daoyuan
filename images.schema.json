{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daoyuan:schema:images:v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "data": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "character",
                  "sect"
                ]
              },
              "images": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https:\\/\\/[^\\s|]+$",
                      "description": "必须以 https:// 开头，且不能包含空白或 |。"
                    },
                    "theme": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                      },
                      "uniqueItems": true
                    },
                    "comment": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500,
                      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                      "description": "不能为空或以空白开头、结尾。"
                    }
                  },
                  "required": [
                    "url",
                    "theme",
                    "tags"
                  ],
                  "additionalProperties": false,
                  "description": "`images.json` 中的一张图片。"
                }
              }
            },
            "required": [
              "type",
              "images"
            ],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": [
        "entities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "data"
  ],
  "additionalProperties": false,
  "description": "`images.json` 的根类型。",
  "title": "Daoyuan Images"
}
