{
  "name": "daoyuan-images",
  "version": "0.1.0",
  "description": "Build and consume Daoyuan image data from TOML sources",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/schema.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "tsx src/cli.ts",
    "build:check": "tsx src/cli.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "tsc -p tsconfig.build.json",
    "format:toml": "tombi format --offline",
    "prepare": "husky && tsc -p tsconfig.build.json"
  },
  "lint-staged": {
    "data/**/*.toml": "tombi format --offline --quiet"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tombi-toml/tombi": "^1.3.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "smol-toml": "^1.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "zod-to-json-schema": "^3.24.1"
  }
}
