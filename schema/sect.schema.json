{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daoyuan:schema:images:sect:v2",
  "type": "object",
  "properties": {
    "images": {
      "type": "object",
      "properties": {
        "map": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https:\\/\\/[^\\s|]+$",
                "description": "必须以 https:// 开头，且不能包含空白或 |。"
              },
              "comment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                "description": "不能为空或以空白开头、结尾。"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "description": "TOML 中的一张图片。"
          }
        }
      },
      "required": [
        "map"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "images"
  ],
  "additionalProperties": false,
  "description": "`data/sect/<name>.toml` 的根类型。",
  "title": "Daoyuan Sect Image Sources"
}
