{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daoyuan:schema:images:theme:v2",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "description": "不能为空或以空白开头、结尾。"
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "description": "不能为空或以空白开头、结尾。"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "uniqueItems": true
    },
    "characters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "images": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s|]+$",
                  "description": "必须以 https:// 开头，且不能包含空白或 |。"
                },
                "comment": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "description": "不能为空或以空白开头、结尾。"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "description": "TOML 中的一张图片。"
            }
          }
        },
        "required": [
          "images"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    }
  },
  "additionalProperties": false,
  "description": "`data/themes/<theme>.toml` 的根类型。",
  "not": {
    "properties": {
      "description": false,
      "comment": false,
      "characters": false
    }
  },
  "title": "Daoyuan Theme Image Sources"
}
